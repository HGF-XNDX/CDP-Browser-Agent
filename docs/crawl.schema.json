{
  "type": "object",
  "properties": {
    "seed_urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      }
    },
    "max_pages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "max_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "link_selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "next_selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "include_patterns": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "exclude_patterns": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "record_patterns": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "item_selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "CSS matching record containers. Field selectors search descendants; root attributes use no field selector."
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "CSS descendant selector relative to the item. Omit selector or use :scope to read the item itself, e.g. {attribute: 'data-id'} for its own data-id."
          },
          "attribute": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "required": {
            "type": "boolean"
          },
          "url": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "allow_empty": {
      "type": "boolean"
    },
    "key_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      }
    }
  },
  "required": [
    "seed_urls"
  ],
  "additionalProperties": false
}
