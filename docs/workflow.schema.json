{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "parameters": {
      "type": "object"
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "min_records": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "request_delay_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "type": {
                "const": "navigate"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "wait_for": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "id",
              "type",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "type": {
                "const": "agent"
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "checks": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "url"
                        },
                        "prefix": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 12000
                        }
                      },
                      "required": [
                        "kind",
                        "prefix"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "visible"
                        },
                        "selector": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 12000
                        },
                        "timeout_ms": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        }
                      },
                      "required": [
                        "kind",
                        "selector"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "text"
                        },
                        "selector": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 12000
                        },
                        "contains": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 12000
                        },
                        "timeout_ms": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        }
                      },
                      "required": [
                        "kind",
                        "selector",
                        "contains"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "minItems": 1,
                "maxItems": 20
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "maxItems": 20
              },
              "allow_tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "maxItems": 50
              },
              "max_steps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "replay_safe": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "type",
              "instructions",
              "checks"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "type": {
                "const": "crawl"
              },
              "start_url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "wait_for": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "item_selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "fields": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 32,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "selector": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "attribute": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12000
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "url": {
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "key_fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                }
              },
              "empty_selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "next_selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "max_pages": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "max_records": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "on_limit": {
                "enum": [
                  "incomplete",
                  "complete"
                ]
              },
              "follow": {
                "type": "object",
                "properties": {
                  "url_field": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  "fields": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 32,
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "selector": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "attribute": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 12000
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "url": {
                          "type": "boolean"
                        }
                      },
                      "required": [],
                      "additionalProperties": false
                    }
                  },
                  "wait_for": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  }
                },
                "required": [
                  "url_field",
                  "fields"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "item_selector",
              "fields",
              "key_fields"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "version",
    "description",
    "allowed_origins",
    "steps"
  ],
  "additionalProperties": false
}
