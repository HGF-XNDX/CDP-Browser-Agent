{
  "name": "patent-article-copy",
  "description": "Preserve each complete source-derived article object without model rewriting.",
  "mode": "mapping",
  "instructions": "Copy the entire article object exactly. Boundaries and completeness are checked by the operator-owned source parser.",
  "field_map": {"article": "article"},
  "require_evidence": false,
  "max_input_chars": 200000,
  "max_records": 2000,
  "max_repairs": 0,
  "timeout_seconds": 300,
  "formats": ["json"],
  "output_schema": {
    "type": "object",
    "required": ["article"],
    "additionalProperties": false,
    "properties": {"article": {
      "type": "object",
      "required": ["article_id", "number", "heading", "scope", "status", "paragraphs", "text", "text_sha256", "source_locator", "source_attributes"],
      "additionalProperties": false,
      "properties": {
        "article_id": {"type": "string", "minLength": 1},
        "number": {"type": "string", "minLength": 1},
        "heading": {"type": "string", "minLength": 1},
        "scope": {"enum": ["main", "supplementary"]},
        "status": {"enum": ["present", "repealed", "renumbered", "deleted"]},
        "paragraphs": {"type": "array", "items": {"type": "string"}},
        "text": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_locator": {"type": "string", "minLength": 1},
        "source_attributes": {"type": "object"}
      }
    }}
  }
}
